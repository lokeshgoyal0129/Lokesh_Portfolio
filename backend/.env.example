# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# PostgreSQL Connection String (Render / local postgres)
# Format: postgres://username:password@host:port/database_name
# Example: DATABASE_URL=postgres://lokesh:password@localhost:5432/portfolio_db
DATABASE_URL=

# Google Gemini API Key for AI Chatbot Agent
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
